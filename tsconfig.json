{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ESNext",
		"moduleResolution": "Bundler",
		"noUncheckedIndexedAccess": true,
		"strict": true,
		"skipLibCheck": true,
		"lib": ["ESNext"],
		"types": ["node"],
		"jsx": "react-jsx",
		"jsxImportSource": "hono/jsx",
		"paths": {
			"@/*": ["./src/*", "./src/core/*", "./src/db/*"]
		}
	}
}
