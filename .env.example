# Copy to `.env` and fill in. Every key here is REQUIRED by EnvSchema
# (src/env.ts) unless marked optional — a missing one fails validation in
# createContainer and every request returns 500.

# --- secrets (production: `wrangler secret put <NAME>`) ---
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"
# Must be >= 32 characters. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-at-least-32-random-characters"

# --- vars ---
ENVIRONMENT="development"          # development | preview | production
BETTER_AUTH_URL="http://localhost:3000"
LOG_LEVEL="debug"                  # debug | info | warn | error  (optional, default: info)
# Comma-separated absolute URLs. Feeds BOTH the CORS middleware and Better
# Auth's `trustedOrigins` (CSRF). Origins compare literally, so list every
# alias you actually browse from — 127.0.0.1 and localhost are not the same.
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

# --- pagination policy (optional; defaults 20 / 100) ---
PAGE_SIZE_DEFAULT="20"
PAGE_SIZE_MAX="100"

# --- not yet wired ---
# API_KEY_PEPPER — add here and to EnvSchema when auth/api-key.service lands.
